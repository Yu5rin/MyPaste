#include <winuser.h>

// 実行ファイル自身のアイコン（エクスプローラ表示用。禁止マーク付きの絵柄）。
// 名前付きリソースはリソースディレクトリ上で数値 ID より先に、かつ名前の
// 昇順で並ぶ。Explorer は最初のアイコングループを既定アイコンとして使うため、
// トレイ用の "ICON_ON"/"ICON_OFF" より前に来るよう "APP"（A 始まり）として、
// 確実に app.ico が EXE アイコンに採用されるようにする。
app             ICON    "src/icons/app.ico"

// タスクトレイ用のアイコン。tray-item から名前で参照する。
icon_on         ICON    "src/icons/icon_on.ico"
icon_off        ICON    "src/icons/icon_off.ico"

// 管理者権限を要求せず通常ユーザーで動作するためのマニフェスト。
CREATEPROCESS_MANIFEST_RESOURCE_ID  RT_MANIFEST  "app.manifest"
